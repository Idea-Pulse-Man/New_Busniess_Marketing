generator client {
  provider = "prisma-client-js"
}

// Supabase Postgres.
// DATABASE_URL: transaction pooler (port 6543, with ?pgbouncer=true) — used by the app at runtime.
// DIRECT_URL:   session pooler (port 5432) — used by `prisma migrate`.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Application {
  id         String   @id @default(cuid())
  name       String
  // Unique among applications that aren't deleted (partial index in migration 9_application_soft_delete).
  email      String
  country    String
  address    String
  whatsapp   String   @default("") // +<country code><number>, optional
  birthday   String   @default("") // YYYY-MM-DD
  experience String // none | under1 | 1to3 | 3plus
  experienceDetail String @default("") // previous jobs, in the applicant's words
  note       String   @default("")
  status     String   @default("pending") // pending | approved | declined
  // Email confirmation. Unconfirmed applications are hidden from admins and can be
  // replaced by a new application for the same email (so a fake entry never blocks the real owner).
  emailVerified     Boolean   @default(false)
  verifyCodeHash    String? // HMAC of the 6-digit code emailed to the applicant
  verifyCodeExpires DateTime?
  verifyAttempts    Int       @default(0) // wrong codes entered for the current code
  verifySentAt      DateTime? // throttles resends
  // Video call booked on Calendly (applicants from the United States book one after confirming their email).
  callAt       DateTime?
  callTimezone String    @default("") // the applicant's IANA time zone, from Calendly
  callInvitee  String?   @unique // Calendly invitee URI; one booking can't be claimed by two applications
  // Set when an admin deletes the application: it's hidden from the dashboard but kept, and the
  // same email can apply again as a new application.
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([email])
  @@index([deletedAt])
  @@index([emailVerified])
  @@index([status])
  @@index([createdAt])
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  // Authenticator (TOTP). Secret is created on first login; enabled once a code is confirmed.
  totpSecret   String?
  totpEnabled  Boolean   @default(false)
  totpLastStep Int? // last accepted time step, blocks code reuse
  // Brute-force protection for password + code
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
}

// Site-wide switches admins change on the dashboard. Always a single row (id 1).
model Settings {
  id           Int      @id @default(1)
  proxyCheck   Boolean  @default(true) // block applications from VPN / proxy IPs
  blockAccess  Boolean  @default(false) // block VPN / proxy and Russian visitors from the whole public site
  mailProvider String   @default("gmail") // gmail | sendgrid
  updatedAt    DateTime @updatedAt
}
