# Supabase → Project → Connect (top bar) → "ORMs" tab → Prisma. Replace [YOUR-PASSWORD].
# Transaction pooler (port 6543) — used by the app at runtime
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (port 5432) — used for migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Long random string used to sign admin session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Emails to applicants go through Gmail or SendGrid — choose on the admin dashboard (Settings).
# Set up the one(s) you use.

# Gmail: needs 2-Step Verification on; create a 16-character app password at
#   https://myaccount.google.com/apppasswords
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"

# SendGrid: Settings → API Keys (Mail Send permission). SENDGRID_FROM must be a verified sender
# (Settings → Sender Authentication). Use an address on your own authenticated domain; a @gmail.com
# sender sent through SendGrid fails Gmail's DMARC check and usually lands in spam.
SENDGRID_API_KEY=""
SENDGRID_FROM="hello@yourdomain.com"

# Optional: where applicants' replies go (a mailbox you actually read).
MAIL_REPLY_TO=""

# Calendly personal access token (Calendly → Integrations → API & Webhooks → Personal access tokens).
# Used to look up the date/time of a US applicant's booked call before sending the "call booked" email.
CALENDLY_TOKEN=""

# Optional proxycheck.io API key (free account at https://proxycheck.io → Dashboard).
# Applications from VPN/proxy IPs are blocked. Without a key: 100 checks/day; with a free key: 1,000/day.
PROXYCHECK_KEY=""
