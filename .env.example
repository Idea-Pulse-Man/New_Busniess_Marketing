# Supabase → Project → Connect (top bar) → "ORMs" tab → Prisma. Replace [YOUR-PASSWORD].
# Transaction pooler (port 6543) — used by the app at runtime
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (port 5432) — used for migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Long random string used to sign admin session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Gmail account that sends "confirm your email" messages to applicants.
# Needs 2-Step Verification on; create a 16-character app password at
#   https://myaccount.google.com/apppasswords
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"

# Public address of the site, used for links in emails (no trailing slash).
# On Vercel this falls back to the production domain if left unset.
SITE_URL="http://localhost:3000"
